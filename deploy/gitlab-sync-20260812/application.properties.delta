# 只逐项合并到 /data/zhengyi/application.properties，不得覆盖服务器完整配置。
# 以下非敏感值来自 2026-08-12 对服务器当前生效配置的只读核对。

zone.passage.parallelism=4
zone.passage.progress-interval=200
zone.passage.status.batch-size=50
zone.passage.trajectory.simplify-zoom=9
zone.passage.backfill.from-date=2025-01-01
zone.passage.backfill.to-date=2026-08-10

ship.behavior.alongside.scene-data.available=true
ship.behavior.alongside.replay.read-timeout-ms=15000
ship.behavior.alongside.replay.bbox-buffer-nm=1.0
ship.behavior.alongside.candidate.min-speed=1.0
ship.behavior.alongside.candidate.max-speed=3.0
